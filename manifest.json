{
  "manifest_version": 3,
  "name": "Prompt Database v1.0.2",
  "version": "1.0.2",
  "description": "Your offline prompt database in a toolbar popup.",
  "permissions": [
    "clipboardWrite",
    "unlimitedStorage"
  ],
  "action": {
    "default_title": "Open Prompt Database v1.0.2",
    "default_popup": "app.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "version_name": "v1.0.2"
}
